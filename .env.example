# 진호 OS — jinho-playground
# 실제 값은 .env.local 또는 OS secrets manager. 이 파일에는 plaintext 키 절대 금지.

# ── Gmail fetcher (finance/gmail.ts) ─────────────────────────
# "mock" (기본, 샘플 데이터) 또는 "live" (실제 Gmail API).
# live 모드를 키려면 ./src/lib/finance/gmail-live.ts 를 먼저 구현해야 함.
GMAIL_FETCH_MODE=mock

# Google OAuth2 (live 모드에서만 필요)
# Google Cloud Console 에서 "OAuth 클라이언트 ID — 데스크톱 앱" 만들고 발급받은 값.
# Gmail API readonly scope 면 충분: https://www.googleapis.com/auth/gmail.readonly
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3740/api/auth/gmail/callback

# 발급받은 refresh_token (절대 git 에 커밋 금지)
GMAIL_REFRESH_TOKEN=

# Gmail 검색 쿼리 — 카드 승인 / 인보이스 / 구독 결제 메일만 좁히기
# 예시:
#   from:no-reply@card.kr OR from:billing@ OR from:receipts@ OR subject:invoice OR subject:승인
GMAIL_SEARCH_QUERY=

# ── 환율 (parser FX_RATE 오버라이드 — optional) ─────────────
# 미지정 시 코드 내 default 사용.
FX_RATE_USD_KRW=
FX_RATE_EUR_KRW=
FX_RATE_JPY_KRW=

# ── Telegram (finance/query route 응답을 봇이 받을 때) ──────
# 실제 값은 OS 환경변수로. 여기엔 plain 값 금지.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
